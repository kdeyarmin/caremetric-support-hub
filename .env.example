# Copy to .env.local for a connected environment.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Demo mode is for local evaluation only. Production builds must set this to false.
VITE_DEMO_MODE=true

# The central URL consumed by product integrations.
VITE_HELP_BASE_URL=https://support-hub-web-production.up.railway.app

# Server-only: Anthropic API key for AI case assistance (staff summary / draft /
# triage), the automated case-resolution loop and the AI team's model runtime
# (an agent calls it only where its own setting allows). Never expose to the browser.
# When unset, every AI endpoint refuses with AI_NOT_CONFIGURED and automation is inert.
ANTHROPIC_API_KEY=
# Server-only: master switch for the customer-facing auto-resolution loop.
# Defaults to off; merging never enables it. Requires ANTHROPIC_API_KEY.
HUB_AI_AUTOMATION_ENABLED=false
# Server-only: hours to wait for a customer reply before the follow-up nudge.
HUB_AI_FOLLOW_UP_DELAY_HOURS=24
# Server-only: draft quality tier for AI replies — "draft" (Sonnet) or "quality" (Opus).
HUB_AI_DRAFT_TIER=draft
VITE_PENNTRAIN_BASE_URL=

# Server-only: unified communications (see docs/UNIFIED_COMMUNICATIONS.md).
# Public origin Twilio and SendGrid call; it must match the webhook URL exactly.
HUB_PUBLIC_ORIGIN=https://support-hub-web-production.up.railway.app
# Inbound and outbound text messages on the support number. Inbound requires the
# Auth Token (signature check); replies also need the Account SID and either a
# Messaging Service SID (preferred) or a sending number. Leave empty to keep SMS off.
HUB_TWILIO_ACCOUNT_SID=
HUB_TWILIO_AUTH_TOKEN=
HUB_TWILIO_MESSAGING_SERVICE_SID=
HUB_TWILIO_FROM_NUMBER=
# Inbound email from SendGrid Inbound Parse with signed webhooks enabled: the
# base64 verification (public) key from SendGrid. Replies need a Mail Send API key.
HUB_SENDGRID_INBOUND_PUBLIC_KEY=
HUB_SENDGRID_API_KEY=
HUB_SUPPORT_FROM_EMAIL=support@caremetric.ai
# Website chat on every Help page. Off unless exactly "true"; merging never enables it.
HUB_CHAT_ENABLED=false

# Server-only: website leads (see docs/LEAD_INTAKE.md). One shared secret per product: each must equal that
# product's own HUB_LEAD_SECRET. Use at least 32 random characters (for example `openssl rand -hex 32`); a
# shorter or empty value counts as not configured, and that product's leads are refused with 503 not_configured.
HUB_LEAD_SECRET_CAREBASE=
HUB_LEAD_SECRET_INTEL=
HUB_LEAD_SECRET_ADVISORS=

# Server-only: the AI team (see docs/AI_TEAM.md). The scheduler is inert unless the flag is
# exactly "true", and every agent also starts paused until the owner resumes it on the Team screen.
HUB_AGENTS_ENABLED=false
# Where the AI team emails alerts and the morning brief. Urgent items are also texted to the
# platform administrator's verified number, which needs the Twilio settings above.
HUB_OWNER_EMAIL=
# The company's postal address, in the footer of every bulk email and every Account Manager customer
# email (CAN-SPAM). The customer emails are neither proposed nor sent without it.
HUB_BULK_EMAIL_POSTAL_ADDRESS=
# Lets the Support Concierge send a plain question's scrubbed text (links, email addresses, phone
# numbers, dates, long numbers and street addresses removed) to the model, to draft an answer for the
# owner to approve. Off unless exactly "true"; needs ANTHROPIC_API_KEY. Set it only when your
# Anthropic agreement covers support messages.
HUB_AGENTS_CUSTOMER_TEXT_TO_AI=false

# Optional: Google Search Console for the SEO Analyst's Monday report (see docs/AI_TEAM.md, "The SEO Analyst").
# Owner steps: in Google Cloud, create a service account and a JSON key for it, and enable the Google Search Console
# API in that project; in Search Console, add the service account's email address as a user on each property. Then set
# the whole JSON key (a secret: it is never shown or logged) and the properties, separated by commas, as Search Console
# names them (an address prefix with its final /), for example sc-domain:cmcarebase.com,https://www.caremetricintel.com/.
# Without both, the report runs from the crawl alone and says how to connect it.
HUB_SEARCH_CONSOLE_CREDENTIALS=
HUB_SEARCH_CONSOLE_SITES=
# Customer growth: CareBase and CareMetric Intel only. See docs/CUSTOMER_GROWTH.md.
# Global transport gate; per-product policy, active agents and message approval also apply.
HUB_GROWTH_SEND_ENABLED=false
# Stable random server secrets, at least 32 characters. Use a DIFFERENT value for each.
HUB_GROWTH_SIGNING_KEY=
HUB_GROWTH_CAREBASE_EVENT_KEY=
HUB_GROWTH_INTEL_EVENT_KEY=
# Optional Brave Search business-research credential. Search never verifies a contact.
HUB_GROWTH_SEARCH_API_KEY=
# SendGrid signed Event Webhook verification key (distinct from Inbound Parse).
HUB_SENDGRID_EVENT_PUBLIC_KEY=
# Social Media Manager (docs/SOCIAL_MEDIA.md). A Meta system user token with access to the Page, Instagram and the ad account.
# Nothing is posted, answered or changed without the owner's approval until a kind of work is handed over on the AI team screen.
HUB_META_ACCESS_TOKEN=
HUB_META_PAGE_ID=
HUB_META_INSTAGRAM_ID=
HUB_META_AD_ACCOUNT_ID=
# LinkedIn Company Page and ad account (docs/SOCIAL_MEDIA.md): a token from your LinkedIn developer app, authorized by a Page
# administrator. With the refresh token, client id and secret set, an expired token is renewed automatically.
HUB_LINKEDIN_ACCESS_TOKEN=
HUB_LINKEDIN_ORGANIZATION_ID=
HUB_LINKEDIN_AD_ACCOUNT_ID=
HUB_LINKEDIN_REFRESH_TOKEN=
HUB_LINKEDIN_CLIENT_ID=
HUB_LINKEDIN_CLIENT_SECRET=
# Optional: when ads need a second LinkedIn app (Advertising API), its token and refresh settings. Unset uses the Page token.
HUB_LINKEDIN_ADS_ACCESS_TOKEN=
HUB_LINKEDIN_ADS_REFRESH_TOKEN=
HUB_LINKEDIN_ADS_CLIENT_ID=
HUB_LINKEDIN_ADS_CLIENT_SECRET=
HUB_LINKEDIN_API_VERSION=
# Optional: brand images (https, comma separated) for Instagram posts; target cost per result and the daily budget cap, in cents.
HUB_SOCIAL_IMAGE_URLS=
HUB_SOCIAL_TARGET_COST_PER_RESULT_CENTS=
HUB_SOCIAL_AD_MAX_DAILY_BUDGET_CENTS=
# Bulk lesson-media import (docs/MEDIA_IMPORT.md). Exact HTTPS host names the server may fetch MP4s from, comma separated.
# Empty uses HeyGen's asset hosts (resource2.heygen.ai, files.heygen.ai, files2.heygen.ai). No wildcards; an invalid value refuses every source.
HUB_MEDIA_IMPORT_HOSTS=
