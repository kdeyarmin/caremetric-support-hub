# Copy to .env.local for a connected environment.
#
# Only secrets and the service's wiring are variables. Every switch, address, account id and limit (the AI team,
# chat, AI answers, email senders, the postal address, the Twilio sender, customer purchasing, social media ids and ad
# limits, Search Console properties) is a setting on the Hub's Settings page (/admin/settings). See docs/SETTINGS.md.
# Do not add a variable here for anything that is not a secret.

# Web app build (compiled into the browser bundle).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Demo mode is for local evaluation only. Production builds must set this to false.
VITE_DEMO_MODE=true
# The central URL consumed by product integrations.
VITE_HELP_BASE_URL=https://support-hub-web-production.up.railway.app
VITE_PENNTRAIN_BASE_URL=

# Server wiring.
# HUB_DATABASE_URL and HUB_DATABASE_CA_PEM: see server/database-config.mjs.
# Public origin Twilio and SendGrid call; it must match their webhook URLs exactly.
HUB_PUBLIC_ORIGIN=https://support-hub-web-production.up.railway.app
# SMS sign-in codes (Telnyx). The profile id stays here so a wrong value can never lock you out of the Hub.
HUB_TELNYX_API_KEY=
HUB_TELNYX_VERIFY_PROFILE_ID=
# Bulk lesson-media import (docs/MEDIA_IMPORT.md). Exact HTTPS host names the server may fetch MP4s from, comma separated.
# Empty uses HeyGen's asset hosts (resource2.heygen.ai, files.heygen.ai, files2.heygen.ai). No wildcards.
HUB_MEDIA_IMPORT_HOSTS=

# Secrets. Server-only: never exposed to the browser, never shown on screen.
# Anthropic: AI case assistance, AI answers on support cases and the AI team. Turn the features on in Settings.
ANTHROPIC_API_KEY=
# Twilio: the Auth Token checks inbound texts; the Account SID lets staff reply (the sender is in Settings → Text messages).
HUB_TWILIO_ACCOUNT_SID=
HUB_TWILIO_AUTH_TOKEN=
# SendGrid: Inbound Parse verification key, Mail Send key, and the signed Event Webhook key (distinct from Inbound Parse).
HUB_SENDGRID_INBOUND_PUBLIC_KEY=
HUB_SENDGRID_API_KEY=
HUB_SENDGRID_EVENT_PUBLIC_KEY=
# Stripe (docs/PLATFORM_BILLING.md).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Website leads (docs/LEAD_INTAKE.md): one secret per product, each equal to that product's own HUB_LEAD_SECRET,
# at least 32 random characters (for example `openssl rand -hex 32`).
HUB_LEAD_SECRET_CAREBASE=
HUB_LEAD_SECRET_INTEL=
HUB_LEAD_SECRET_ADVISORS=
# Customer growth (docs/CUSTOMER_GROWTH.md): stable random secrets of at least 32 characters, a different value for each.
HUB_GROWTH_SIGNING_KEY=
HUB_GROWTH_CAREBASE_EVENT_KEY=
HUB_GROWTH_INTEL_EVENT_KEY=
# Optional Brave Search business-research key.
HUB_GROWTH_SEARCH_API_KEY=
# Social Media Manager (docs/SOCIAL_MEDIA.md): the Meta system user token, and the LinkedIn tokens and app secrets.
HUB_META_ACCESS_TOKEN=
HUB_LINKEDIN_ACCESS_TOKEN=
HUB_LINKEDIN_REFRESH_TOKEN=
HUB_LINKEDIN_CLIENT_SECRET=
HUB_LINKEDIN_ADS_ACCESS_TOKEN=
HUB_LINKEDIN_ADS_REFRESH_TOKEN=
HUB_LINKEDIN_ADS_CLIENT_SECRET=
# Google Search Console service account JSON key, pasted whole (the properties are in Settings → Search).
HUB_SEARCH_CONSOLE_CREDENTIALS=
# CareBase course distribution observer token.
CAREBASE_DISTRIBUTION_OBSERVER_TOKEN=
