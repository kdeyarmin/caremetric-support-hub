{
  "name": "caremetric-support-hub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/help-sdk"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "build:sdk": "npm run build --workspace @caremetric/help-sdk",
    "test:sdk": "npm run test --workspace @caremetric/help-sdk",
    "pack:sdk": "npm pack --workspace @caremetric/help-sdk",
    "evaluate:growth": "node scripts/evaluate-growth.mjs",
    "verify:live": "node --use-env-proxy scripts/verify-live-flows.mjs",
    "test:growth:db": "node server/growth-integration.mjs",
    "test:growth-autonomy:db": "node server/agents-growth-autonomy-integration.mjs",
    "test:watch": "vitest",
    "lint": "eslint .",
    "check": "npm run check:docs && npm run typecheck && npm run lint && npm run test && npm run test:sdk && npm run build:sdk && npm run build",
    "check:docs": "node scripts/check-self-service-docs.mjs && node scripts/generate-self-service-guides.mjs --check",
    "generate:guides": "node scripts/generate-self-service-guides.mjs",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:test": "supabase test db",
    "start": "node server/main.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "@fontsource/geist-sans": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@resvg/resvg-js": "2.6.2",
    "@supabase/supabase-js": "2.115.0",
    "ffmpeg-static": "5.3.0",
    "lucide-react": "1.16.0",
    "pg": "8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "7.18.2",
    "satori": "0.63.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.10.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.0",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.5",
    "globals": "17.7.0",
    "jsdom": "30.0.1",
    "supabase": "2.116.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6",
    "vitest": "4.1.12"
  },
  "overrides": {
    "eslint": {
      "minimatch": "11.0.5"
    },
    "@eslint/config-array": {
      "minimatch": "11.0.5"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.5"
    },
    "satori": {
      "fflate": "0.7.5"
    }
  }
}
